# ==============================================================
# CareerIQ Backend — Environment Configuration Template
# ==============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.

# --- Application ---
APP_ENV=development
APP_NAME=CareerIQ
APP_VERSION=1.0.0
DEBUG=true

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://careeriq_user:careeriq_pass@localhost:5432/careeriq_db

# Sync URL used only by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://careeriq_user:careeriq_pass@localhost:5432/careeriq_db

# --- JWT / Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_64_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- File Storage ---
# local | s3 | supabase
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data
MAX_UPLOAD_SIZE_MB=10

# S3 / Supabase (only needed when STORAGE_BACKEND=s3 or supabase)
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# --- LLM (Optional) ---
# Leave empty to use the deterministic fallback assistant
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-1.5-flash

# --- Email (Optional) ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@careeriq.dev

# --- Logging ---
LOG_LEVEL=INFO

# --- Rate Limiting ---
AUTH_RATE_LIMIT=20/minute
